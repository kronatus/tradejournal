# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Marketdata.app (option quotes + Greeks) — primary provider.
# Free Forever plan: 100 credits/day, no card, no brokerage account.
# An undated option request costs ONE CREDIT PER CONTRACT, so the app quotes
# only the legs you hold rather than pulling whole chains.
# Get a token at https://www.marketdata.app/dashboard/
MARKETDATA_API_TOKEN=your-marketdata-token

# Tradier (optional fallback) — requires a funded Tradier brokerage account.
# Used only when MARKETDATA_API_TOKEN is unset.
TRADIER_API_TOKEN=

# Optional: force a provider instead of auto-selecting. "marketdata" | "tradier"
MARKET_DATA_PROVIDER=
